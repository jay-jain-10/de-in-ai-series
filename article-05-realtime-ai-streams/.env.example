# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here
ENRICHMENT_MODEL=claude-haiku-4-5-20251001

# Kafka (MSK)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=fraud-detector
KAFKA_EVENTS_TOPIC=transactions
KAFKA_SCORES_TOPIC=risk-scores
KAFKA_ALERTS_TOPIC=fraud-alerts

# Redis (ElastiCache)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_MS=100

# PostgreSQL (RDS)
POSTGRES_DSN=postgresql://user:password@localhost:5432/fraud

# Pipeline
ENRICHMENT_VERSION=1
DAILY_BUDGET_USD=50
