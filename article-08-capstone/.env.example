# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here
EXTRACTION_MODEL=claude-sonnet-5-5
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001

# Gateway team API keys (referenced by config/teams.yaml)
CLAIMS_TEAM_API_KEY=change-me-claims
COMPLIANCE_TEAM_API_KEY=change-me-compliance
CUSTOMER_SUCCESS_API_KEY=change-me-cs
DATA_TEAM_API_KEY=change-me-data

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INCOMING_TOPIC=documents.incoming
KAFKA_COST_TOPIC=gateway.cost_events

# Cache tiers
REDIS_URL=redis://localhost:6379/0
CACHE_S3_BUCKET=your-cache-bucket
AWS_DEFAULT_REGION=us-east-1

# Snowflake
SNOWFLAKE_ACCOUNT=your-account.us-east-1
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Platform tuning
LAYER2_SAMPLE_RATE=0.1
CONFIDENCE_THRESHOLD=0.7
