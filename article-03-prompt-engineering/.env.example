# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AWS S3 prompt registry (runtime read target; Git stays the source of truth)
PROMPT_REGISTRY_BUCKET=your-prompt-registry-bucket
PROMPT_REGISTRY_KEY=prompts/registry.yaml
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
PROMPT_ALERT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:prompt-drift-alerts

# Snowflake
SNOWFLAKE_ACCOUNT=your-account.us-east-1
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Models (same ids as Article 1)
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
ESCALATION_MODEL=claude-sonnet-5-5

# Governance thresholds (defaults match the article)
GOLDEN_MAX_FAIL_RATE=0.05
GOLDEN_MAX_CONFIDENCE_DROP=0.05
MONITOR_SAMPLE_RATE=0.01
